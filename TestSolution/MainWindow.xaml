<Window x:Class="TestSolution.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestSolution"
        Title="Runia Skin Renderer" Height="450" Width="800" Background="#1e1e1e">
    <Grid>
        <StackPanel VerticalAlignment="Top" Margin="20">
            <TextBlock Text="Источник скина:" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="UrlInput" Text="https://minotar.net/skin/Steve" Padding="5"/>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Content="Из интернета" Click="LoadFromUrl_Click" Height="30" Margin="0,0,5,0"/>
                <Button Content="Открыть файл" Click="LoadFromFile_Click" Height="30" Margin="5,0,0,0"/>
            </UniformGrid>
        </StackPanel>
        <local:SkinView x:Name="PlayerPreview" Margin="0,100,0,0"/>
    </Grid>
</Window>